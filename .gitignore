# =============================================================
# Unity 项目 .gitignore（基于 Unity 官方模板，Unity 2022.3）
# 仅忽略本地生成目录与文件，不改动任何项目内容
# =============================================================

# Unity 生成的目录（打开编辑器后自动重新生成）
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Bb]uildReport/
[Cc]rashReport/

# 崩溃时 Unity 自动生成的文件
sysinfo.txt

# 构建产物
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics 生成的文件
crashlytics-build.properties

# Packed Addressables
[Ll]ibrary/[Pp]ackage[Cc]ache/

# 临时自动生成的 Android Assets
[Ss]ystem/[Aa]ndroid/[Aa]ssets/

# Android
[Pp]roject[Ss]ettings/[Gg]radle[Pp]roperties.override
[Pp]roject[Ss]ettings/[Gg]radle.properties
[Pp]roject[Ss]ettings/gradle-enterprise.gradle

# Unity 生成的文件（每次打开编辑器都会重新生成）
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.crd

# Visual Studio 缓存目录
.vs/

# Visual Studio 相关
*.psess
*.vsp
*.vspx
*.sap

# JetBrains Rider / VS Code
.idea/
.vscode/
*.sln.iml

# OS 生成文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db
Thumbs.db

# 其他
*.log
*.orig
